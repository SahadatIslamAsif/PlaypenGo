# Local Supabase (from `supabase status` after `supabase start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Used by scripts/seed-subjects-catalog.ts (Phase 2) and, from Phase 6, the
# cron digest route only. Never prefix this with NEXT_PUBLIC_ — it must never
# reach the client (CLAUDE.md "Hard rules").
SUPABASE_SERVICE_ROLE_KEY=
