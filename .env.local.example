# Local Supabase (from `supabase status` after `supabase start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Used by scripts/seed-subjects-catalog.ts (Phase 2) and app/api/cron/
# evening-digest (Phase 5's TTL sweep now; Phase 6's digest lands in the same
# route). Never prefix this with NEXT_PUBLIC_ — it must never reach the
# client (CLAUDE.md "Hard rules").
SUPABASE_SERVICE_ROLE_KEY=

# Checked against the cron route's own Authorization: Bearer header (§7.2).
# cron-job.org is configured with this value by hand; Vercel's own Cron Jobs
# (vercel.json) send it automatically once this is set as a Vercel env var.
CRON_SECRET=

# Phase 5's scan pipeline (§5.3). Server-only — never prefix with NEXT_PUBLIC_.
# Verify the model ID against ai.google.dev's pricing page before setting it;
# IDs churn (CLAUDE.md). Must show a free-tier row.
GEMINI_API_KEY=
GEMINI_MODEL=

# Phase 6's digest (§2, §7). Nodemailer over SMTP - Brevo's free tier, or a
# dedicated Gmail account with an app password. Nothing in lib/email is
# provider-specific, so switching is an env change, not a code change.
# SMTP_PORT defaults to 587 (STARTTLS); 465 switches to implicit TLS on its
# own. SMTP_FROM defaults to SMTP_USER, which most free tiers require the
# envelope sender to be anyway.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# The origin the digest builds its /c/<token> links against (§7.6). Must be
# the public URL, not localhost - these links are opened from a phone's mail
# app, not from the machine that sent them.
APP_URL=
